# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

.agents/
skills-lock.json
# Virtual environments
.venv/
# The evals extra installs deepteam, which resolves deepeval, openai, posthog, grpcio and a
# different pytest. It lives in its own environment so `.venv` stays the `.[dev]`-plus-`bench`
# tree that CI mirrors — an evaluation harness must not be able to change what the suite runs on.
.venv-evals/
venv/
env/

# Testing / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Where scripts/deploy.py stages the artefact before it is uploaded and deleted. Never committed:
# it is a build output whose whole point is that it is reproducible from the commit.
.deploy/

# CareLoop runtime artifacts
*.sqlite3
*.sqlite3-journal
# SQLite in WAL mode writes two sidecars beside the database, and they are not covered by the
# patterns above. A served CareLoop uses WAL, so a `git add -A` taken while the demo is running
# sweeps in a multi-megabyte binary nothing can reproduce — which happened once, in this session.
*.sqlite3-wal
*.sqlite3-shm
.careloop/
caseloop.db

# Secrets / local config
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# SSH keys � never commit
.keys/
*.pem

# The motion package the boot layer and the orchestration field are vendored from. The two files
# CareLoop uses live in `frontend/public/` with their local deltas marked; the archive itself is a
# 63 KB binary nothing in the build reads and nothing here can regenerate.
careloop-motion.zip
careloop-site.zip
artifacts/
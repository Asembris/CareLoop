# CareLoop's deployed configuration. Read by both systemd units via EnvironmentFile.
#
# Committed on purpose: there is nothing here worth hiding. Bedrock is reached through the
# instance profile attached to the host, exactly as the AgentCore runtime reaches it, so no
# access key ever lands on the box. If a secret ever needs to be here, it does not go here —
# it goes in Secrets Manager and this file names it.

# Region for both Bedrock and the SDK's inference-profile prefix.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# The measured defaults from docs/model-benchmark.md, closed by session B. Triage is Nova Micro
# at a tenth of the cost; the planner and extraction are Nova 2 Lite. `bedrock:us.amazon.nova-
# lite-v1:0` is deliberately absent — given an explicit booking instruction alongside a document
# asking for something else, it proposed emailing the document's address.
CARELOOP_MODEL_TRIAGE=bedrock:us.amazon.nova-micro-v1:0
CARELOOP_MODEL_PLANNER=bedrock:us.amazon.nova-2-lite-v1:0
CARELOOP_MODEL_EXTRACTION=bedrock:us.amazon.nova-2-lite-v1:0

# Demo World, on this same host. Loopback rather than the public URL on purpose: the booking is a
# real HTTP call to a service in another process, which is what the read-back verifies, and
# sending it out to the CDN and back would add a second of latency to prove nothing extra.
CARELOOP_CLINIC_URL=http://127.0.0.1:8100

# The bucket the second real external effect files documents into. Private, Block Public Access
# on, SSE-S3, versioning OFF, and a one-day lifecycle rule on the `careloop/` prefix. Reached
# through the instance profile exactly as Bedrock is, so no key ever lands on the box. Without this
# variable every upload is simulated, exactly as every booking is without CARELOOP_CLINIC_URL.
#
# Versioning stays off deliberately: it is what keeps a read of a deleted key an unambiguous
# absence. See docs/objectstore-contract.md for the measured contract this depends on, and
# docs/deployment-objectstore.md for the bucket and IAM policy.
#
# **Left empty here on purpose, and a deploy does not decide it.** The bucket name is per account,
# so committing one would make this file wrong for everybody else. scripts/deploy.py carries the
# value the instance already has forward across the tree swap, and only overwrites it when an
# operator passes --upload-bucket. Simulated uploads are therefore the default everywhere,
# including on a host that has never been told about a bucket.
#
# There is no CARELOOP_UPLOAD_PREFIX. Every key is `careloop/<session>/<idempotency-key>`, from
# careloop.tools.objectstore.DEFAULT_PREFIX, which is a module constant and reads no environment.
# The lifecycle rule and the IAM policy name that literal.
CARELOOP_UPLOAD_BUCKET=

# Where the durable source of truth lives when there is one world for everybody. The deployed unit
# runs with --isolate-sessions, which gives each visitor an in-memory world instead, so this path
# is *unused as deployed* and is here so that dropping the flag restores the durable single world.
CARELOOP_DB=/opt/careloop/state/demo.sqlite3

# The built frontend, served from this same origin so no CORS middleware is ever needed.
CARELOOP_STATIC_DIR=/opt/careloop/app/frontend/dist

# ---------------------------------------------------------------------------------------------
# AgentCore Observability — telemetry only, and only outward.
# ---------------------------------------------------------------------------------------------
# The collector-less ADOT SDK path: this process signs OTLP itself and posts it to CloudWatch.
# There is no collector, which is not a simplification we chose — AWS states the ADOT Collector is
# not supported for agent observability outside AgentCore Runtime. See
# docs/adr/0004-agentcore-observability-out-of-band.md for the whole decision.
#
# Every variable below is set explicitly, including the ones whose library default already matches.
# A default is something a dependency bump can change silently; a line in this file is not.

# Routes this process's telemetry to the AgentCore surface in CloudWatch.
AGENT_OBSERVABILITY_ENABLED=true

# Pinned rather than left to entry-point auto-selection. Both `aws_distro` and upstream `distro`
# register, and with neither variable set the loader picks one silently — measured during the
# spike, where a run believed to be upstream was in fact ADOT. Upstream cannot reach CloudWatch at
# all (it signs nothing and generates non-X-Ray trace ids), so which one loads is load-bearing.
OTEL_PYTHON_DISTRO=aws_distro
OTEL_PYTHON_CONFIGURATOR=aws_configurator

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_SERVICE_NAME=careloop
OTEL_RESOURCE_ATTRIBUTES=service.name=careloop,aws.log.group.names=/aws/bedrock-agentcore/runtimes/careloop
OTEL_EXPORTER_OTLP_LOGS_HEADERS=x-aws-log-group=/aws/bedrock-agentcore/runtimes/careloop,x-aws-log-stream=runtime-logs,x-aws-metric-namespace=bedrock-agentcore

# --- the privacy boundary, stated rather than inherited -------------------------------------
# No prompt, no model response, no tool argument and no tool result reaches a span. The OTel
# default is already false; it is written here because this is the line that must never change.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Strands' own content redaction is OPT-IN and off by default: absent this token, span events
# carry `gen_ai.input.messages`, `gen_ai.output.messages` and `gen_ai.system_instructions`
# unredacted. An empty allowlist means "redact everything sensitive". The cost is real and
# accepted: the graph span's one event becomes `[REDACTED]` instead of `run case <case_id>`, so a
# trace is correlated by trace id rather than by case id. Nothing today constructs a strands.Agent,
# but this is what stops the day one does from being a content leak.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_unredacted_attributes=

# Application Signals stays OFF. Its metric generator copies the calling credential's access key id
# into `aws.remote.resource.account.access_key` — a credential identifier as a metric dimension.
# The redaction processor in scripts/observability.py already neutralises that path, and this
# pins it shut as well. Independent of AGENT_OBSERVABILITY_ENABLED; verified in the distro source.
OTEL_AWS_APPLICATION_SIGNALS_ENABLED=false

# fastapi/starlette: a run returns 202 and continues on a background task for seconds, so the
#   server span would end while `invoke_graph` was still open — a ~20 ms parent over a multi-second
#   child. Disabling them leaves `invoke_graph` as the trace root, which is the honest shape.
#   Fixing it the other way would mean changing RunRegistry's context propagation for prettier
#   telemetry, which is application complexity bought with nothing.
# sqlite3: a span per store operation, on the durable source of truth. The domain record is the
#   timeline, not a trace of its writes.
# system_metrics: emits host metrics nobody asked for and nobody budgeted.
# logging: rewrites log records to carry trace ids, which is a log-format change and its own
#   decision.
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=fastapi,starlette,sqlite3,system_metrics,logging

# --- identity ------------------------------------------------------------------------------------
#
# Which identity story this deployment tells. `demo` -- or leaving this unset -- is the judge-facing
# synthetic caregiver over a synthetic world holding no real records, which is what the public URL
# has always served. `production` verifies a real OIDC access token and derives the caregiver from
# it; the two are mutually exclusive at construction and a failed production verification can never
# resolve to the demo identity.
#
# A value that is neither is **refused at startup** rather than treated as demo: a typo here must
# not be the difference between authenticating and not.
CARELOOP_AUTH_MODE=demo

# The OIDC issuer, exactly as it appears in a token's `iss`. For a Cognito user pool this is
# https://cognito-idp.<region>.amazonaws.com/<pool-id> -- and the JWKS endpoint is derived from it
# by appending /.well-known/jwks.json, so there is no second variable to keep in step.
#
# Not a secret. It is published in every token this deployment will ever see.
CARELOOP_OIDC_ISSUER=

# The app client id, matched exactly against `client_id` on an access token. Cognito access tokens
# carry no `aud` at all, which is why this is checked against `client_id` rather than against `aud`.
#
# Not a secret either, and there is deliberately **no client secret variable**: the browser client
# is a public PKCE client, and giving one a secret would mean storing a credential in a page anybody
# can read.
CARELOOP_OIDC_AUDIENCE=

# With CARELOOP_AUTH_MODE=production, both of the above are required and the process refuses to
# start without them. That is the same treatment an unguarded destination gets from the policy
# loader: a gap that stops the process is one somebody fixes.

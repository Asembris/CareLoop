[Unit]
Description=CareLoop — the dashboard API and the built frontend
Documentation=https://github.com/Asembris/CareLoop
# Demo World is not a hard dependency: without it every effect stays simulated and a verification
# honestly reports read_back=false. The API must come up either way rather than refusing to start
# because a service it does not own is down.
After=network-online.target
Wants=network-online.target careloop-demoworld.service

[Service]
Type=exec
User=careloop
Group=careloop
WorkingDirectory=/opt/careloop/app
EnvironmentFile=/opt/careloop/app/deploy/careloop.env
# --isolate-sessions is what lets two judges open the URL at the same moment. Every visitor gets
# their own case store, run registry and clinic, so neither can see or reset the other's world.
# With it on, --db is not used: a world lives in memory for as long as somebody is using it, and
# durable cross-process ownership is demonstrated by scripts/resume_demo.py rather than here.
# --db stays on the line so that dropping the flag restores the single durable world exactly.
# `opentelemetry-instrument` is the collector-less ADOT entry point: it configures the SDK and
# loads the instrumentations before the script's first line, then execs it. Everything it needs is
# in careloop.env, including which distro to load — nothing is left to entry-point auto-selection.
#
# **This wrapper is the only thing that turns telemetry on, and removing it is the whole rollback.**
# The uninstrumented line is kept immediately below, commented, because that is the fallback the
# lifespan and every test already assume: without the wrapper the global tracer provider is a
# no-op, no span is recorded, and scripts/observability.py reports "not instrumented" at startup.
# Telemetry is not part of CareLoop's availability contract, and this is where that is true.
ExecStart=/opt/careloop/venv/bin/opentelemetry-instrument \
    /opt/careloop/venv/bin/python scripts/demo_serve.py \
    --host 0.0.0.0 \
    --port 8000 \
    --isolate-sessions \
    --db ${CARELOOP_DB} \
    --clinic-url ${CARELOOP_CLINIC_URL} \
    --static-dir ${CARELOOP_STATIC_DIR} \
    --env-file /dev/null

# ROLLBACK — swap the two: comment the block above, uncomment this, `systemctl daemon-reload &&
# systemctl restart careloop-api`. No code change, no reinstall, no redeploy.
#ExecStart=/opt/careloop/venv/bin/python scripts/demo_serve.py \
#    --host 0.0.0.0 \
#    --port 8000 \
#    --isolate-sessions \
#    --db ${CARELOOP_DB} \
#    --clinic-url ${CARELOOP_CLINIC_URL} \
#    --static-dir ${CARELOOP_STATIC_DIR} \
#    --env-file /dev/null

# Restart on failure, but give the app's own lifespan a chance to drain in-flight runs first: a
# run killed mid-flight leaves a case wherever its last committed node put it. Recoverable —
# the store is the truth — but a graph two nodes from DONE would need a human to notice.
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT

# The process needs to read the tree, write the SQLite file, and reach Bedrock. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/careloop/state

[Install]
WantedBy=multi-user.target
